{
	email lihsheng1997@gmail.com
	servers :443 {
		protocols h1 h2 h3
	}
}

# Reverse proxy for n8n (Docker) on localhost:5678 — behind Cloudflare proxy
n8n.lihsheng.space {
	tls internal
	encode zstd gzip
	reverse_proxy 127.0.0.1:5678
}

