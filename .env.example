OPENAB_ROOT=/path/to/ops-room
OPS_ROOM_ROOT=${OPENAB_ROOT}/ops-room
OPS_ROOM_DATA_DIR=${OPENAB_ROOT}/data/ops-room

OPENAB_CONFIG_DIR=${OPENAB_ROOT}/config
OPENAB_AGENTS_CONFIG_DIR=${OPENAB_ROOT}/config/agents
OPENAB_HARNESS_CONFIG=${OPENAB_ROOT}/config/harness/ops-room.local.toml

OPENAB_DATA_DIR=${OPENAB_ROOT}/data
OPENAB_AGENTS_DIR=${OPENAB_ROOT}/data/agents
OPENAB_WORKSPACES_DIR=${OPENAB_ROOT}/data/workspaces
OPENAB_SHARED_DIR=${OPENAB_ROOT}/data/shared
OPENAB_SECRETS_DIR=${OPENAB_ROOT}/secrets

GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=${OPENAB_SECRETS_DIR}/professor-key.pem
GITHUB_WEBHOOK_SECRET=

OPS_ROOM_HOST=0.0.0.0
OPS_ROOM_PORT=3000
