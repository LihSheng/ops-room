# Use explicit absolute paths. Node's --env-file loader does not expand ${...} references.
OPENAB_ROOT=/path/to/openab-multi-agent
OPS_ROOM_ROOT=/path/to/openab-multi-agent/ops-room
OPS_ROOM_DATA_DIR=/path/to/openab-multi-agent/data/ops-room

OPENAB_CONFIG_DIR=/path/to/openab-multi-agent/config
OPENAB_AGENTS_CONFIG_DIR=/path/to/openab-multi-agent/config/agents
OPENAB_DATA_DIR=/path/to/openab-multi-agent/data
OPENAB_AGENTS_DIR=/path/to/openab-multi-agent/data/agents
OPENAB_WORKSPACES_DIR=/path/to/openab-multi-agent/data/workspaces
OPENAB_SHARED_DIR=/path/to/openab-multi-agent/data/shared
OPENAB_SECRETS_DIR=/path/to/openab-multi-agent/secrets

GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_KEY_PATH=/path/to/openab-multi-agent/secrets/professor-key.pem
OPENAB_WEBHOOK_SECRET=
OPS_ROOM_OPERATOR_API_ENABLED=false
OPS_ROOM_OPERATOR_TOKEN=

OPENAB_WEBHOOK_HOST=127.0.0.1
OPENAB_WEBHOOK_PORT=7381
OPS_ROOM_RELEASE_SHA=development
OPS_ROOM_SHUTDOWN_TIMEOUT_MS=55000
OPS_ROOM_ISSUE_POLLING_ENABLED=true

# Curated agent-readable knowledge only. Never point this at the whole Obsidian vault.
OPENAB_AGENT_KNOWLEDGE_DIR=/path/to/published-agent-knowledge
